---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <style>
    /* Film grain overlay — fixed, full viewport, NO mix-blend-mode */
    body::after {
      content: '';
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background-image: url('data:image/svg+xml;base64,');
      background-repeat: repeat;
      background-size: 256px 256px;
      opacity: 0.06;
      pointer-events: none;
      z-index: 99;
    }

    .section {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 2rem;
      position: relative;
    }

    /* ===== SECTION 1: HERO ===== */
    .section-1 {
      background: linear-gradient(to bottom, var(--bg-paper), var(--bg-paper-dark));
      flex-direction: column;
      text-align: center;
    }

    .wordmark {
      font-family: var(--font-mono);
      font-size: 0.65rem;
      letter-spacing: 0.25em;
      color: var(--ink);
      margin-bottom: 0.3rem;
      text-transform: uppercase;
    }

    .rainbow-stripe {
      height: 2px;
      width: 35px;
      background: linear-gradient(to right, #FF6B6B 0%, #FFD93D 16%, #6BCB77 33%, #4D96FF 50%, #9D4EDD 66%, #FF006E 100%);
      margin: 0.4rem auto 0;
    }

    h1 {
      font-family: var(--font-serif);
      font-size: clamp(2rem, 7vw, 3.5rem);
      line-height: 1.15;
      letter-spacing: -0.02em;
      color: var(--ink);
      margin: 1.5rem 0 2.5rem;
      max-width: 850px;
    }

    .hero-watch {
      max-width: 380px;
      margin: 0 auto 2rem;
      position: relative;
      transform: rotate(8deg);
      filter: drop-shadow(0 30px 40px rgba(0,0,0,0.18));
    }

    .hero-watch img {
      width: 100%;
      height: auto;
      display: block;
    }

    .hero-caption {
      font-family: var(--font-serif);
      font-size: 0.95rem;
      font-style: italic;
      color: var(--ink);
      line-height: 1.7;
      max-width: 650px;
      margin: 0 auto;
    }

    .scroll-cue {
      position: absolute;
      bottom: 2rem;
      left: 50%;
      transform: translateX(-50%);
      font-family: var(--font-serif);
      color: var(--ink);
      animation: pulse 1.5s ease-out infinite;
    }

    @keyframes pulse {
      0%, 100% { opacity: 0.4; }
      50% { opacity: 1; }
    }

    /* ===== SECTION 2: THE COST (DARK SPREAD) ===== */
    .section-2 {
      background: linear-gradient(to right, var(--bg-dark-navy) 0%, var(--bg-dark-navy) 55%, rgba(17,21,34,0.3) 100%);
      color: var(--bg-paper);
      flex-direction: column;
      text-align: center;
      position: relative;
      overflow: hidden;
    }

    .section-2::before {
      content: '';
      position: absolute;
      right: 0;
      top: 0;
      width: 50%;
      height: 100%;
      background-image: url('/images/volt-titanium-dark.png');
      background-position: center;
      background-size: cover;
      background-repeat: no-repeat;
      opacity: 0.3;
      z-index: 0;
      pointer-events: none;
    }

    @media (max-width: 768px) {
      .section-2::before {
        opacity: 0.15;
        width: 100%;
      }
    }

    .cost-content {
      max-width: 700px;
      position: relative;
      z-index: 1;
    }

    .cost-lines {
      margin-bottom: 2.5rem;
    }

    .cost-line {
      font-family: var(--font-serif);
      font-size: clamp(1.4rem, 3.5vw, 2rem);
      line-height: 1.3;
      margin-bottom: 2rem;
      opacity: 0;
      animation: fadeInUpCost 0.6s ease-out forwards;
      color: var(--bg-paper);
    }

    .cost-line:nth-child(1) { animation-delay: 0s; }
    .cost-line:nth-child(2) { animation-delay: 0.25s; }
    .cost-line:nth-child(3) { animation-delay: 0.5s; }
    .cost-line:nth-child(4) { animation-delay: 0.75s; }

    @keyframes fadeInUpCost {
      from {
        opacity: 0;
        transform: translateY(15px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .cost-closer {
      font-family: var(--font-serif);
      font-size: 0.9rem;
      color: var(--bg-paper);
      margin-top: 1.5rem;
      letter-spacing: 0.005em;
    }

    .counter {
      font-weight: 500;
      color: var(--mint);
    }

    /* ===== SECTION 3: THE DEFECTION ===== */
    .section-3 {
      background: linear-gradient(to bottom, var(--bg-paper), var(--bg-paper-dark));
      gap: 4rem;
    }

    .defection-content {
      flex: 1;
      max-width: 480px;
    }

    h2 {
      font-family: var(--font-serif);
      font-size: clamp(1.6rem, 5vw, 2.3rem);
      line-height: 1.2;
      letter-spacing: -0.015em;
      color: var(--ink);
      margin-bottom: 1.2rem;
    }

    .defection-copy {
      font-family: var(--font-serif);
      font-size: 0.95rem;
      color: var(--ink);
      margin-bottom: 1.8rem;
      line-height: 1.8;
    }

    .refusal-list {
      list-style: none;
      margin-bottom: 1.8rem;
    }

    .refusal-item {
      font-family: var(--font-mono);
      font-size: 0.8rem;
      color: var(--ink);
      margin-bottom: 0.85rem;
      opacity: 0;
      animation: fadeInItem 0.5s ease-out forwards;
      letter-spacing: 0.015em;
    }

    .refusal-item:nth-child(1) { animation-delay: 0s; }
    .refusal-item:nth-child(2) { animation-delay: 0.1s; }
    .refusal-item:nth-child(3) { animation-delay: 0.2s; }
    .refusal-item:nth-child(4) { animation-delay: 0.3s; }

    @keyframes fadeInItem {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    .counterpoint {
      font-family: var(--font-serif);
      font-size: 0.95rem;
      color: var(--ink);
      border-left: 2px solid var(--ink);
      padding-left: 1.5rem;
      margin-top: 1.5rem;
      line-height: 1.8;
    }

    .section-3-image {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 500px;
    }

    .section-3-image img {
      max-width: 320px;
      height: auto;
      display: block;
      filter: drop-shadow(0 20px 35px rgba(0,0,0,0.15));
    }

    @media (max-width: 768px) {
      .section-3 {
        flex-direction: column;
      }

      .section-3-image {
        order: -1;
        min-height: 350px;
      }
    }

    /* ===== SECTION 4: THE CONVICTION ===== */
    .section-4 {
      background: linear-gradient(to bottom, var(--bg-paper), var(--bg-paper-dark));
      flex-direction: column;
    }

    .conviction-content {
      max-width: 700px;
      text-align: center;
    }

    .conviction-copy {
      font-family: var(--font-serif);
      font-size: 0.95rem;
      color: var(--ink);
      margin-bottom: 2.5rem;
      line-height: 1.8;
    }

    .conviction-statements {
      display: flex;
      flex-direction: column;
      gap: 0;
    }

    .statement {
      font-family: var(--font-mono);
      font-size: 0.8rem;
      color: var(--ink);
      padding: 1rem 0;
      border-top: 1px solid var(--ink);
      letter-spacing: 0.015em;
    }

    .statement:last-child {
      border-bottom: 1px solid var(--ink);
    }

    /* ===== SECTION 5: LEAD CAPTURE ===== */
    .section-5 {
      background: linear-gradient(to bottom, var(--bg-paper), var(--bg-paper-dark));
      flex-direction: column;
    }

    .capture-content {
      max-width: 520px;
      text-align: center;
    }

    .product-stamp {
      max-width: 100px;
      margin: 0 auto 1.5rem;
      opacity: 0.9;
    }

    .product-stamp img {
      width: 100%;
      height: auto;
      display: block;
    }

    .capture-subline {
      font-family: var(--font-serif);
      font-size: 0.9rem;
      color: var(--ink);
      margin-bottom: 2rem;
      letter-spacing: 0.005em;
    }

    .form-wrapper {
      margin-bottom: 1.5rem;
    }

    .form-group {
      margin-bottom: 1rem;
    }

    .form-group label {
      display: block;
      font-family: var(--font-mono);
      font-size: 0.7rem;
      margin-bottom: 0.5rem;
      color: var(--ink);
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .form-group input {
      width: 100%;
      padding: 0.8rem 1rem;
      background-color: transparent;
      border: 1px solid var(--ink);
      color: var(--ink);
      font-family: var(--font-mono);
      font-size: 0.85rem;
      transition: all 200ms ease-out;
      letter-spacing: 0.01em;
    }

    .form-group input::placeholder {
      color: rgba(43, 42, 39, 0.35);
    }

    .form-group input:focus-visible {
      outline: none;
      border-color: var(--ink);
      box-shadow: 0 0 0 3px rgba(199, 212, 184, 0.3);
    }

    .form-error {
      font-family: var(--font-mono);
      font-size: 0.7rem;
      color: #b80000;
      margin-top: 0.4rem;
      display: none;
      letter-spacing: 0.015em;
    }

    .form-error.show {
      display: block;
    }

    .btn {
      width: 100%;
      padding: 0.9rem 1.5rem;
      background-color: var(--ink);
      border: 1px solid var(--ink);
      color: var(--bg-paper);
      font-family: var(--font-mono);
      font-size: 0.8rem;
      letter-spacing: 0.07em;
      cursor: pointer;
      transition: all 200ms ease-out;
      text-transform: uppercase;
      font-weight: 500;
    }

    .btn:hover:not(:disabled) {
      background-color: transparent;
      color: var(--ink);
    }

    .btn:focus-visible {
      outline: 2px solid var(--mint);
      outline-offset: 2px;
    }

    .btn:disabled {
      opacity: 0.55;
      cursor: not-allowed;
    }

    .form-honeypot {
      display: none;
    }

    .form-success {
      display: none;
      animation: fadeIn 0.5s ease-out;
    }

    .form-success.show {
      display: block;
    }

    .success-message {
      font-family: var(--font-serif);
      color: var(--ink);
      margin-bottom: 0.4rem;
    }

    .success-timestamp {
      font-family: var(--font-mono);
      font-size: 0.75rem;
      color: var(--ink);
      letter-spacing: 0.015em;
    }

    @keyframes fadeIn {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    .form-note {
      font-family: var(--font-serif);
      font-size: 0.8rem;
      color: var(--ink);
      margin-top: 1.2rem;
      opacity: 0.75;
      letter-spacing: 0.005em;
    }

    /* ===== FOOTER ===== */
    footer {
      background: linear-gradient(to bottom, var(--bg-paper), var(--bg-paper-dark));
      border-top: 1px solid var(--ink);
      padding: 2rem;
      text-align: center;
      position: relative;
      z-index: 10;
    }

    footer p {
      font-family: var(--font-mono);
      font-size: 0.7rem;
      color: var(--ink);
      letter-spacing: 0.015em;
    }

    footer a {
      color: var(--ink);
      transition: opacity 200ms ease-out;
    }

    footer a:hover {
      opacity: 0.6;
    }
  </style>

  <!-- SECTION 1: HERO -->
  <section class="section section-1">
    <div class="wordmark">
      VOLT
      <div class="rainbow-stripe"></div>
    </div>

    <h1>
      They put a slot machine on your wrist.<br />
      You called it an upgrade.
    </h1>

    <div class="hero-watch">
      <img src="/images/volt-front-white.png" alt="Volt watch front view" width="380" height="380" loading="eager" />
    </div>

    <p class="hero-caption">
      Every buzz is a bet placed on your attention. The house always wins.
    </p>

    <div class="scroll-cue">▼</div>
  </section>

  <!-- SECTION 2: THE COST (DARK INK SPREAD) -->
  <section class="section section-2">
    <div class="cost-content">
      <div class="cost-lines">
        <div class="cost-line">The report you never finished.</div>
        <div class="cost-line">The dinner you only half attended.</div>
        <div class="cost-line">The run cut short at mile two.</div>
        <div class="cost-line">The sleep you traded for a glow at 11:47 PM.</div>
      </div>

      <p class="cost-closer">
        You checked your wrist <span class="counter">0</span> times today. How many were worth it?
      </p>
    </div>
  </section>

  <!-- SECTION 3: THE DEFECTION -->
  <section class="section section-3">
    <div class="defection-content">
      <h2>
        Volt. The watch that works for you.<br />
        Not for them.
      </h2>

      <p class="defection-copy">
        Your smartwatch answers to any app that pays for your attention. Volt answers to you. Time, goals, silence. Everything else waits.
      </p>

      <ul class="refusal-list">
        <li class="refusal-item">✕ Interrupt your work block for a flash sale.</li>
        <li class="refusal-item">✕ Buzz through dinner for an email that could wait.</li>
        <li class="refusal-item">✕ Turn your run into a public scoreboard.</li>
        <li class="refusal-item">✕ Glow in your bedroom after 9 PM.</li>
      </ul>

      <p class="counterpoint">
        The people who truly matter always get through. The rest arrives in batches, on your schedule.
      </p>
    </div>

    <div class="section-3-image">
      <img src="/images/volt-angle-white.png" alt="Volt watch 3/4 view" width="320" height="320" loading="lazy" />
    </div>
  </section>

  <!-- SECTION 4: THE CONVICTION -->
  <section class="section section-4">
    <div class="conviction-content">
      <h2>We left nothing for you to configure.</h2>

      <p class="conviction-copy">
        We made the decisions. That's what building something means. One product, one opinion. Made to last years on your wrist — not until next year's launch.
      </p>

      <div class="conviction-statements">
        <div class="statement">Ready the day it arrives.</div>
        <div class="statement">No settings screen to get lost in.</div>
        <div class="statement">No annual upgrade to chase.</div>
      </div>
    </div>
  </section>

  <!-- SECTION 5: LEAD CAPTURE -->
  <section class="section section-5">
    <div class="capture-content">
      <div class="product-stamp">
        <img src="/images/volt-front-white.png" alt="Volt watch stamp" loading="lazy" />
      </div>

      <h2>The first units go to the people who get it.</h2>

      <p class="capture-subline">Leave your email. You'll hear from us before anyone else.</p>

      <div class="form-wrapper">
        <form id="leadForm" method="POST" action="/api/subscribe">
          <div class="form-group">
            <label for="email">Email</label>
            <input
              type="email"
              id="email"
              name="email"
              placeholder="you@example.com"
              required
              aria-required="true"
            />
            <div class="form-error" id="emailError"></div>
          </div>

          <input type="text" name="website" class="form-honeypot" autocomplete="off" />

          <button type="submit" class="btn" id="submitBtn">Cut the leash</button>
        </form>

        <div class="form-success" id="successMessage">
          <p class="success-message">You're on the list. Unit by unit, we'll notify in order of arrival.</p>
          <p class="success-timestamp" id="timestamp"></p>
        </div>
      </div>

      <p class="form-note">One email when Volt opens. No others. We promise little on purpose.</p>
    </div>
  </section>

  <!-- FOOTER -->
  <footer>
    <p>VOLT · built to last · contact: <a href="mailto:hello@volt.example.com">hello@volt.example.com</a></p>
  </footer>

  <script>
    // Counter animation
    const counterEl = document.querySelector('.counter');
    let counterAnimated = false;

    const animateCounter = () => {
      if (counterAnimated) return;
      counterAnimated = true;

      let current = 0;
      const target = 94;
      const duration = 1200;
      const start = Date.now();

      const animate = () => {
        const elapsed = Date.now() - start;
        const progress = Math.min(elapsed / duration, 1);
        current = Math.floor(target * progress);
        counterEl.textContent = current;

        if (progress < 1) {
          requestAnimationFrame(animate);
        } else {
          counterEl.textContent = target;
        }
      };

      animate();
    };

    const counterObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          animateCounter();
          counterObserver.unobserve(entry.target);
        }
      });
    });

    counterObserver.observe(counterEl);

    // Form handling
    const form = document.getElementById('leadForm');
    const emailInput = document.getElementById('email');
    const emailError = document.getElementById('emailError');
    const submitBtn = document.getElementById('submitBtn');
    const successMessage = document.getElementById('successMessage');
    const timestamp = document.getElementById('timestamp');

    const validateEmail = (email) => {
      const regex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      return regex.test(email);
    };

    const getUTMParams = () => {
      const params = new URLSearchParams(window.location.search);
      return {
        utm_source: params.get('utm_source') || '',
        utm_medium: params.get('utm_medium') || '',
        utm_campaign: params.get('utm_campaign') || '',
      };
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const email = emailInput.value.trim();
      emailError.classList.remove('show');
      emailError.textContent = '';

      if (!validateEmail(email)) {
        emailError.textContent = "That email doesn't look right.";
        emailError.classList.add('show');
        return;
      }

      submitBtn.disabled = true;
      let spinnerFrame = 0;
      const spinnerInterval = setInterval(() => {
        const spinner = '|/-\\'[spinnerFrame % 4];
        submitBtn.textContent = spinner;
        spinnerFrame++;
      }, 120);

      try {
        const utmParams = getUTMParams();
        const response = await fetch('/api/subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, ...utmParams }),
        });

        clearInterval(spinnerInterval);

        if (response.ok || response.status === 409) {
          form.style.display = 'none';
          successMessage.classList.add('show');

          const now = new Date();
          const dateStr = now.toLocaleDateString();
          const timeStr = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
          timestamp.textContent = `position recorded at ${dateStr} ${timeStr}`;

          if (typeof window.va !== 'undefined') {
            window.va('event', { name: 'lead_submit' });
          }
        } else {
          emailError.textContent = 'Something went wrong. Try again.';
          emailError.classList.add('show');
          submitBtn.disabled = false;
          submitBtn.textContent = 'Cut the leash';
        }
      } catch (err) {
        clearInterval(spinnerInterval);
        emailError.textContent = 'Something went wrong. Try again.';
        emailError.classList.add('show');
        submitBtn.disabled = false;
        submitBtn.textContent = 'Cut the leash';
      }
    });

    // Analytics tracking
    const trackEvent = (eventName) => {
      if (typeof window.va !== 'undefined') {
        window.va('event', { name: eventName });
      }
    };

    let scroll50 = false;
    let scroll100 = false;

    window.addEventListener('scroll', () => {
      const scrollPercent = (window.scrollY / (document.documentElement.scrollHeight - window.innerHeight)) * 100;

      if (scrollPercent >= 50 && !scroll50) {
        scroll50 = true;
        trackEvent('scroll_50');
      }

      if (scrollPercent >= 100 && !scroll100) {
        scroll100 = true;
        trackEvent('scroll_100');
      }
    });

    emailInput.addEventListener('focus', () => {
      trackEvent('form_focus');
    }, { once: true });

    // Font loading verification
    document.addEventListener('DOMContentLoaded', () => {
      Promise.all([
        document.fonts.load('400 1em EB Garamond'),
        document.fonts.load('400 1em IBM Plex Mono'),
      ]).then(() => {
        console.log('Fonts loaded:', Array.from(document.fonts).map(f => f.family + ': ' + f.status));
      }).catch((err) => {
        console.warn('Font loading error:', err);
      });
    });
  </script>
</Layout>
