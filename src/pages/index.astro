---
import Layout from '../layouts/Layout.astro';

// spec v3 §7: the Bench ships HIDDEN until the flat-lay asset exists.
// Flip to true when /images/bench.jpg (per v2 §5) is delivered.
const BENCH_READY = false;
---

<Layout>
  {/* is:global — the page builds DOM at runtime (cards, ticks, receipt lines);
      scoped styles would miss those elements */}
  <style is:global>
    /* ===== Film grain: pre-baked PNG tile ONLY (feTurbulence/blend modes crash GPUs) ===== */
    .grain {
      position: fixed;
      inset: 0;
      background: url('/grain-256.png') repeat;
      background-size: 256px 256px;
      opacity: 0.035;
      pointer-events: none;
      z-index: 50;
    }

    .grain.hot {
      opacity: 0.14;
    }

    main {
      position: relative;
      z-index: 1;
    }

    section {
      position: relative;
      background: radial-gradient(ellipse 110% 85% at 50% 50%, var(--bg-lift) 0%, var(--bg) 72%);
    }

    h1,
    h2 {
      font-family: var(--font-serif);
      font-weight: 400;
      color: var(--ink);
    }

    /* poster scale — two-axis clamp so composed headlines always fit the viewport
       (7.8vw, not 8.5: the longest composed line must clear the right margin) */
    h1 {
      font-size: clamp(3rem, min(7.8vw, 15vh), 10rem);
      line-height: 0.95;
      letter-spacing: -0.01em;
    }

    h2 {
      font-size: clamp(2.4rem, min(7vw, 13vh), 7rem);
      line-height: 0.98;
      letter-spacing: -0.01em;
    }

    em {
      font-style: italic; /* venom words only */
    }

    .mono {
      font-family: var(--font-mono);
      letter-spacing: 0.04em;
    }

    .fw {
      font-family: var(--font-mono);
      font-size: 0.85rem;
      letter-spacing: 0.04em;
      text-transform: lowercase;
    }

    .marker {
      position: absolute;
      top: 2rem;
      left: 2rem;
      font-family: var(--font-mono);
      font-size: 0.7rem;
      letter-spacing: 0.18em;
      color: var(--ink-ghost);
      z-index: 2;
    }

    .caption {
      font-family: var(--font-mono);
      font-size: 0.7rem;
      letter-spacing: 0.08em;
      color: var(--ink-ghost);
      text-transform: lowercase;
    }

    /* ===== generic entrance: a single opacity step (not a fade) ===== */
    .step {
      opacity: 0;
    }

    .step.on {
      opacity: 1;
    }

    /* ===== 00 — Boot stamp ===== */
    .boot {
      position: fixed;
      inset: 0;
      background: #000;
      z-index: 100;
      display: none;
      align-items: center;
      justify-content: center;
      padding: 1.5rem;
    }

    html[data-boot] .boot {
      display: flex;
    }

    .boot .fw {
      color: var(--ink-dim);
      white-space: pre-wrap;
      text-align: center;
    }

    /* ===== chaos overlays ===== */
    .flashover {
      position: fixed;
      inset: 0;
      background: #fff;
      opacity: 0;
      pointer-events: none;
      z-index: 60;
    }

    .blackout {
      position: fixed;
      inset: 0;
      background: #000;
      display: none;
      z-index: 70;
    }

    /* ===== personality stamps (§3): one voice at a time ===== */
    .top-stamp {
      position: fixed;
      top: 0;
      left: 50%;
      transform: translate(-50%, -110%);
      max-width: 92vw;
      padding: 0.7rem 1.1rem;
      background: var(--bg);
      border-bottom: 1px solid rgba(var(--ink-rgb), 0.15);
      color: var(--ink-dim);
      text-align: center;
      z-index: 80;
      transition: transform 300ms cubic-bezier(0.2, 0, 0.2, 1);
    }

    .top-stamp.show {
      transform: translate(-50%, 0);
    }

    .ghost-line {
      position: fixed;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      color: var(--ink-dim);
      display: none;
      z-index: 80;
      text-align: center;
    }

    .ghost-line.show {
      display: block;
    }

    /* page sleep — wake on move; the dot keeps beating */
    .sleep {
      position: fixed;
      inset: 0;
      background: #000;
      opacity: 0;
      pointer-events: none;
      z-index: 85;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 2rem;
      visibility: hidden;
      transition: opacity 2000ms linear, visibility 0s 2000ms;
    }

    .sleep.asleep {
      opacity: 0.92;
      visibility: visible;
      transition: opacity 2000ms linear;
    }

    .sleep.waking {
      opacity: 0;
      visibility: hidden;
      transition: opacity 300ms linear, visibility 0s 300ms;
    }

    .sleep .fw {
      color: var(--ink-dim);
    }

    /* held-interruptions counter (§3.6) — discreet, bottom-left */
    .held {
      position: fixed;
      left: 1.2rem;
      bottom: 1rem;
      color: var(--ink-ghost);
      z-index: 45;
    }

    /* crown navigation (§3.5) */
    .crown {
      position: fixed;
      right: 10px;
      top: 50%;
      width: 18px;
      height: 18px;
      border-radius: 50%;
      border: 1px solid rgba(var(--ink-rgb), 0.3);
      z-index: 45;
      cursor: grab;
      touch-action: none;
      transform: translateY(-50%);
    }

    .crown::before {
      content: '';
      position: absolute;
      inset: 2px;
      border-radius: 50%;
      background: repeating-conic-gradient(rgba(var(--ink-rgb), 0.28) 0 12deg, transparent 12deg 30deg);
    }

    .crown.grabbing {
      cursor: grabbing;
      border-color: rgba(var(--ink-rgb), 0.55);
    }

    .crown-label {
      position: fixed;
      right: 38px;
      top: 50%;
      transform: translateY(-50%);
      color: var(--ink-dim);
      white-space: nowrap;
      display: none;
      z-index: 45;
    }

    .crown-label.show {
      display: block;
    }

    @media (pointer: coarse) {
      .crown,
      .crown-label {
        display: none !important;
      }
    }

    /* ===== night stamp ===== */
    .night-stamp {
      display: none;
      position: absolute;
      top: 0.9rem;
      left: 50%;
      transform: translateX(-50%);
      width: max-content;
      max-width: 92vw;
      font-size: 0.7rem;
      letter-spacing: 0.08em;
      color: var(--amber);
      z-index: 5;
      text-align: center;
    }

    html.night .night-stamp {
      display: block;
    }

    /* ===== 01 — Hero (recomposed) ===== */
    .hero {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: 14vh 1.5rem 6rem;
      overflow: hidden;
    }

    .hero-inner {
      width: min(1280px, 100%);
      margin: 0 auto;
      position: relative;
    }

    .wordmark {
      position: absolute;
      top: 2rem;
      left: 2rem;
      font-family: var(--font-mono);
      font-size: 0.8rem;
      font-weight: 500;
      letter-spacing: 0.35em;
      color: var(--ink-dim);
      z-index: 3;
    }

    /* verb: sweep — masked wipe, one composed line per beat. Breaks are content. */
    .hl-line {
      display: block;
      white-space: nowrap;
    }

    .hl-inner {
      display: inline-block;
      clip-path: inset(0 100% 0 0);
    }

    .hl-line.on .hl-inner {
      clip-path: inset(0 -2% 0 0);
      transition: clip-path 550ms cubic-bezier(0.6, 0, 0.2, 1);
    }

    /* the period blinks at 1Hz — the page opens and closes on the same heartbeat */
    .hl-period {
      animation: blink 1s linear infinite;
    }

    @keyframes blink {
      0%, 55% { opacity: 1; }
      56%, 100% { opacity: 0.12; }
    }

    .hero-sub {
      font-style: normal; /* roman, not italic */
      font-size: clamp(1.1rem, 1.7vw, 1.35rem);
      color: var(--ink-dim);
      margin-top: 2.6rem;
      max-width: 44ch;
    }

    /* the reel — anchored top-right third. phosphor green like the watch LCD. verb: ignite */
    .reel {
      position: absolute;
      right: 8vw;
      top: 14vh;
      width: 140px;
      height: 140px;
      border-radius: 30px;
      background: #0A100B;
      border: 1px solid rgba(var(--ink-rgb), 0.25);
      overflow: hidden;
      filter: brightness(0);
      z-index: 2;
    }

    .reel.lit {
      filter: brightness(1);
      transition: filter 120ms linear;
    }

    html.night .reel.lit {
      filter: brightness(0.4);
    }

    .reel-strip {
      font-family: var(--font-mono);
      font-size: 1.9rem;
      line-height: 46.667px; /* 140/3 — three glyphs visible */
      text-align: center;
      color: rgba(126, 226, 138, 0.9); /* phosphor green — the watch LCD, not the page palette */
      animation: reel-spin 2.8s linear infinite;
    }

    .reel.paused .reel-strip {
      animation-play-state: paused;
    }

    /* 1-bit: hard glyphs behind a dithered scanline screen */
    .reel::after {
      content: '';
      position: absolute;
      inset: 0;
      background: repeating-linear-gradient(0deg, transparent 0 2px, rgba(0, 0, 0, 0.5) 2px 3px);
      pointer-events: none;
    }

    @keyframes reel-spin {
      from { transform: translateY(0); }
      to { transform: translateY(-50%); }
    }

    @media (max-width: 900px) {
      .reel {
        position: static;
        margin-top: 3rem;
      }

      .hl-line {
        white-space: normal;
      }
    }

    .scroll-cue {
      position: absolute;
      bottom: 28px;
      left: 50%;
      transform: translateX(-50%);
      font-family: var(--font-mono);
      font-size: 0.8rem;
      color: var(--ink-ghost);
    }

    /* ===== 02 — The Tally: the machine you crank ===== */
    .tally {
      height: 260vh; /* 100vh pin + ~160vh of scrub — the scroll IS the time of day */
    }

    .tally-sticky {
      position: sticky;
      top: 0;
      height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 14vh 1.5rem 4rem;
      overflow: hidden;
    }

    .tally-clock {
      position: absolute;
      top: 2rem;
      right: 2rem;
      font-size: 0.8rem;
      color: var(--ink-dim);
      font-variant-numeric: tabular-nums;
    }

    .tally-pre,
    .tally-post {
      font-size: 1.3rem;
      color: var(--ink-dim);
    }

    /* odometer drums — serif digits on rolling cylinders, like a watch date window */
    .drums {
      display: flex;
      gap: 10px;
      margin: 2.2rem 0;
      font-family: var(--font-serif);
      font-size: clamp(4rem, min(9vw, 13vh), 8rem);
      font-variant-numeric: tabular-nums;
    }

    .drums.clunk {
      animation: clunk 100ms linear;
    }

    @keyframes clunk {
      0% { transform: translateY(0); }
      50% { transform: translateY(4px); }
      100% { transform: translateY(0); }
    }

    .drum {
      height: 3em;
      width: 0.72em;
      overflow: hidden;
      border: 1px solid rgba(var(--ink-rgb), 0.18); /* hairline frame */
      position: relative;
    }

    .drum-col {
      line-height: 1;
      will-change: transform;
    }

    .drum-col div {
      height: 1em;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    /* cylinder shading — neighbors above/below read at ~15% */
    .drum::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(
        180deg,
        var(--bg) 0%,
        rgba(12, 14, 11, 0.85) 18%,
        transparent 40%,
        transparent 60%,
        rgba(12, 14, 11, 0.85) 82%,
        var(--bg) 100%
      );
      pointer-events: none;
    }

    /* the day strip: 96 ticks, 07:00 → 23:00 */
    .daystrip {
      display: flex;
      align-items: center;
      gap: 14px;
      width: min(760px, 88vw);
      margin-top: 2.4rem;
    }

    .strip-label {
      font-size: 0.65rem;
      color: var(--ink-ghost);
    }

    .ticks {
      position: relative;
      flex: 1;
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      height: 26px;
    }

    .tick {
      width: 2px;
      height: 13px;
      background: rgba(var(--ink-rgb), 0.14);
    }

    .tick.lit {
      background: rgba(var(--ink-rgb), 0.55);
    }

    .tick.flick {
      background: rgba(var(--ink-rgb), 0.95);
    }

    /* the lock: strip extinguishes except the three that mattered (receipt family — amber) */
    .ticks.out .tick.lit {
      background: rgba(var(--ink-rgb), 0.18);
    }

    .ticks.out .tick.matters {
      background: #B87E0A;
      height: 22px;
    }

    .tick-label {
      position: absolute;
      top: 30px;
      transform: translateX(-50%);
      font-family: var(--font-mono);
      font-size: 0.62rem;
      letter-spacing: 0.05em;
      color: #B87E0A;
      white-space: nowrap;
      opacity: 0;
    }

    .ticks.out ~ * .tick-label,
    .ticks.out .tick-label {
      opacity: 1;
    }

    .daystrip-wrap {
      position: relative;
      padding-bottom: 2.4rem;
    }

    .tally-fw {
      color: var(--ink-dim);
      margin-top: 2.6rem;
      min-height: 1.4em;
    }

    .tally-q {
      font-style: italic;
      font-size: 1.3rem;
      color: var(--ink-dim);
      margin-top: 1rem;
    }

    @media (max-width: 640px) {
      .tick-label {
        font-size: 0.52rem;
      }

      .tick-label.tl-mid {
        top: 44px;
      }
    }

    /* ===== 03 — The Cost (sticky scroll beats) ===== */
    .cost {
      height: 320vh;
    }

    .cost-sticky {
      position: sticky;
      top: 0;
      height: 100vh;
      display: flex;
      align-items: center;
      overflow: hidden;
      padding: 14vh 1.5rem 4rem;
    }

    .cost-photo {
      position: absolute;
      top: 0;
      right: -2%;
      width: 47%;
      height: 100%;
    }

    .cost-photo img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      filter: var(--img-filter);
      -webkit-mask-image: radial-gradient(ellipse 62% 55% at 50% 50%, #000 32%, transparent 74%);
      mask-image: radial-gradient(ellipse 62% 55% at 50% 50%, #000 32%, transparent 74%);
    }

    .cost-caption {
      position: absolute;
      bottom: 2rem;
      right: 2rem;
    }

    .cost-inner {
      width: min(1200px, 100%);
      margin: 0 auto;
      position: relative;
      z-index: 1;
    }

    .cost-lines {
      max-width: 60%;
    }

    /* verb: replace — a stack of regrets. Each regret is composed lines, no widows. */
    .cost-line {
      font-family: var(--font-serif);
      color: var(--ink);
      font-size: clamp(1.7rem, min(6vw, 6.2vh), 4rem);
      line-height: 1.05;
      letter-spacing: -0.01em;
      margin-bottom: 1.4rem;
      opacity: 0;
    }

    .cost-line.on {
      opacity: 1;
    }

    .cost-line.on.dim {
      opacity: 1;
      color: var(--ink-ghost);
      transition: color 500ms ease-out;
    }

    /* the only glowing text on the page */
    .glow-time {
      text-shadow: 0 0 22px rgba(var(--ink-rgb), 0.55);
    }

    @media (max-width: 768px) {
      .cost-photo {
        right: 0;
        width: 100%;
      }

      .cost-photo img {
        opacity: 0.22;
      }

      .cost-lines {
        max-width: 100%;
      }
    }

    /* ===== 04 — The Noise ===== */
    .noise {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden; /* cards are absolutely contained — zero bleed into 03/05 */
      padding: 14vh 1.5rem 6rem;
    }

    .noise-cards {
      position: absolute;
      inset: 0;
      pointer-events: none;
      overflow: hidden;
    }

    .noise-cards .noise-card {
      position: absolute;
    }

    /* real card anatomy — the ONLY place a third (UI sans) font appears:
       it plays "everyone else's design" */
    .noise-card {
      width: min(300px, 74vw);
      background: #15140F;
      border: 1px solid rgba(var(--ink-rgb), 0.08);
      border-radius: 8px;
      padding: 10px 12px;
      display: flex;
      gap: 10px;
      align-items: flex-start;
      box-shadow: 0 10px 32px rgba(0, 0, 0, 0.55);
      font-family: -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      color: rgba(var(--ink-rgb), 0.9);
    }

    .nc-icon {
      width: 16px;
      height: 16px;
      flex: none;
      font-size: 13px;
      line-height: 16px;
      text-align: center;
      opacity: 0.8;
    }

    .nc-title {
      font-size: 0.78rem;
      font-weight: 600;
      line-height: 1.3;
    }

    .nc-body {
      font-size: 0.74rem;
      line-height: 1.35;
      opacity: 0.65;
    }

    .noise.calm .noise-card {
      opacity: 0.3;
    }

    html.night .noise-cards .noise-card {
      opacity: 0.25;
    }

    .noise-after {
      position: relative;
      z-index: 2;
      text-align: center;
    }

    .ornot {
      font-family: var(--font-serif);
      font-style: italic;
      font-size: clamp(3rem, min(8.5vw, 15vh), 10rem);
      line-height: 0.95;
      color: var(--ink);
    }

    .noise-fw {
      color: var(--ink-dim);
      margin-top: 2.4rem;
    }

    .noise-stamp {
      position: relative;
      z-index: 2;
      display: none;
      color: var(--amber);
      font-size: 0.85rem;
    }

    html.night .noise-stamp {
      display: block;
    }

    html.night .noise-after {
      display: none;
    }

    /* ===== 05 — The Refusal ===== */
    .refusal {
      overflow: hidden;
      padding: 14vh 1.5rem 8rem;
    }

    .refusal-inner {
      max-width: 1240px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: 6fr 6fr;
      gap: 4rem;
      align-items: start; /* headline in the upper third, not at the fold */
    }

    .refusal-photo {
      align-self: start;
      width: 118%;
      margin-left: -12%;
      aspect-ratio: 875 / 1216;
      max-height: 120vh;
      overflow: hidden;
      position: relative;
    }

    .refusal-photo img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      filter: var(--img-filter);
      -webkit-mask-image: radial-gradient(ellipse 60% 52% at 52% 48%, #000 34%, transparent 76%);
      mask-image: radial-gradient(ellipse 60% 52% at 52% 48%, #000 34%, transparent 76%);
    }

    /* §3.2 cursor pool of light — active in 05 and 07 only, rationed */
    .pool-veil {
      position: absolute;
      inset: 0;
      background: rgba(8, 7, 4, 0.7);
      pointer-events: none;
      z-index: 2;
      -webkit-mask-image: radial-gradient(circle 180px at var(--mx, 50%) var(--my, 50%), transparent 0 45%, #000 78%);
      mask-image: radial-gradient(circle 180px at var(--mx, 50%) var(--my, 50%), transparent 0 45%, #000 78%);
    }

    .refusal-caption {
      margin-top: 0.4rem;
      margin-left: 6%;
    }

    .refusal h2 {
      max-width: 16ch;
    }

    .refusal-aside {
      font-style: italic;
      font-size: 1.05rem;
      color: var(--ink-dim);
      margin-top: 1.6rem;
    }

    /* verb: stamp — a mono ledger, mechanical snaps */
    .ledger {
      list-style: none;
      margin-top: 2.8rem;
      font-family: var(--font-mono);
      font-size: 0.85rem;
      letter-spacing: 0.04em;
      text-transform: lowercase;
      max-width: 46ch;
      color: var(--ink);
    }

    .ledger li {
      padding: 1.3rem 0;
      border-bottom: 1px solid rgba(var(--ink-rgb), 0.12);
      opacity: 0;
      transform-origin: left center;
    }

    .ledger li:first-child {
      border-top: 1px solid rgba(var(--ink-rgb), 0.12);
    }

    .ledger li.on {
      animation: stamp 180ms cubic-bezier(0.2, 0, 0.2, 1) forwards;
    }

    .ledger .x {
      display: inline-block;
      width: 1.6em;
      color: var(--ink-dim);
    }

    @keyframes stamp {
      0% { opacity: 0; transform: scale(1.25); }
      55% { opacity: 1; transform: scale(0.97); }
      100% { opacity: 1; transform: scale(1); }
    }

    .matter {
      border-left: 2px solid rgba(var(--ink-rgb), 0.35);
      padding-left: 1.4rem;
      margin-top: 2.8rem;
      font-size: 1.15rem;
      line-height: 1.6;
      max-width: 44ch;
    }

    @media (max-width: 768px) {
      .refusal-inner {
        grid-template-columns: 1fr;
        gap: 2.5rem;
      }

      .refusal-photo {
        margin-left: 0;
        width: 100%;
        aspect-ratio: auto;
        height: 55vh;
        max-height: none;
      }

      .refusal-caption {
        margin: 0.6rem 0 0;
      }
    }

    /* ===== 06 — The Conviction (the rest beat — image-free) ===== */
    .conviction {
      min-height: 140vh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: 14vh 1.5rem 12rem;
    }

    .conviction-inner {
      max-width: 1100px;
      width: 100%;
      margin: 0 auto;
    }

    .conviction-copy {
      font-size: 1.05rem;
      line-height: 1.75;
      color: var(--ink);
      margin: 4.5rem 0 8rem auto;
      max-width: 46ch;
    }

    .conviction-copy p + p {
      margin-top: 1.4rem;
    }

    .creed {
      color: var(--ink-dim);
      padding: 1.2rem 0;
      max-width: 34ch;
    }

    /* asymmetric distribution: left / center-right / left */
    .creed:nth-child(1) { margin-right: auto; }
    .creed:nth-child(2) { margin-left: 58%; }
    .creed:nth-child(3) { margin-right: auto; margin-top: 2rem; }

    @media (max-width: 768px) {
      .creed:nth-child(2) { margin-left: 20%; }
    }

