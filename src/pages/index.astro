---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <style>
    /* ===== Film grain: plain-opacity tile, no blend modes ===== */
    .grain {
      position: fixed;
      inset: 0;
      background: url('/grain-256.png') repeat;
      background-size: 256px 256px;
      opacity: 0.08;
      pointer-events: none;
      z-index: 50;
    }

    main {
      position: relative;
      z-index: 1;
    }

    section {
      /* barely-visible vignette lifting each section's center out of the black */
      background: radial-gradient(ellipse 110% 85% at 50% 50%, var(--black-lift) 0%, var(--black) 72%);
    }

    h1,
    h2 {
      font-family: var(--font-serif);
      font-weight: 400;
      color: var(--bone);
    }

    h1 {
      font-size: clamp(2.6rem, 6vw, 5rem);
      line-height: 1.05;
      letter-spacing: -0.01em;
    }

    h2 {
      font-size: clamp(2rem, 4.5vw, 3.2rem);
      line-height: 1.05;
      letter-spacing: -0.01em;
    }

    .mono {
      font-family: var(--font-mono);
      letter-spacing: 0.04em;
    }

    /* ===== Reveals: slow fades + small drifts, once ===== */
    .reveal {
      opacity: 0;
      transform: translateY(20px);
      transition: opacity 800ms ease-out, transform 800ms ease-out;
      transition-delay: var(--d, 0ms);
    }

    .reveal.is-visible {
      opacity: 1;
      transform: none;
    }

    /* ===== Macro fragments: feathered into the dark, slow 8s breathe ===== */
    .fragment {
      overflow: hidden;
    }

    /* quiet serif asides — same voice as the hero caption */
    .aside {
      font-style: italic;
      font-size: 1.05rem;
      color: var(--bone-dim);
      line-height: 1.6;
    }

    .fragment img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transform: scale(1);
      transition: transform 8000ms ease-out;
    }

    .fragment.is-visible img {
      transform: scale(1.04);
    }

    @media (prefers-reduced-motion: reduce) {
      .reveal {
        opacity: 1;
        transform: none;
        transition: none;
      }

      .fragment img,
      .fragment.is-visible img {
        transform: none;
        transition: none;
      }
    }

    /* ===== 1. Hero — pure text in darkness ===== */
    .hero {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      position: relative;
      padding: 4rem 1.5rem 6rem;
    }

    .wordmark {
      font-family: var(--font-mono);
      font-size: 0.75rem;
      font-weight: 500;
      letter-spacing: 0.35em;
      text-indent: 0.35em;
    }

    .rainbow {
      width: 64px;
      height: 4px;
      margin: 8px auto 0;
      opacity: 0.7;
      background: linear-gradient(
        to right,
        #A6524B 0 16.667%,
        #BE7245 16.667% 33.333%,
        #C4A94F 33.333% 50%,
        #74895F 50% 66.667%,
        #5B7794 66.667% 83.333%,
        #756084 83.333% 100%
      );
    }

    .hero h1 {
      max-width: 17ch;
      margin-top: 3.5rem;
    }

    .hero-caption {
      font-style: italic;
      font-size: clamp(1.1rem, 1.7vw, 1.35rem);
      color: var(--bone-dim);
      margin-top: 2.8rem;
      max-width: 44ch;
    }

    .scroll-cue {
      position: absolute;
      bottom: 28px;
      left: 50%;
      transform: translateX(-50%);
      font-family: var(--font-mono);
      font-size: 0.8rem;
      animation: cue-pulse 2.4s ease-out infinite;
    }

    @keyframes cue-pulse {
      0%, 100% { opacity: 0.2; }
      50% { opacity: 0.8; }
    }

    /* ===== 2. The cost — the waking LCD ===== */
    .cost {
      min-height: 100vh;
      position: relative;
      overflow: hidden;
      display: flex;
      align-items: center;
      padding: 7rem 1.5rem;
    }

    .cost-photo {
      position: absolute;
      top: 0;
      right: -2%;
      width: 47%;
      height: 100%;
    }

    .cost-photo img {
      /* feathered to black on all sides; center on the LCD glow */
      -webkit-mask-image: radial-gradient(ellipse 62% 55% at 50% 50%, #000 32%, transparent 74%);
      mask-image: radial-gradient(ellipse 62% 55% at 50% 50%, #000 32%, transparent 74%);
    }

    .cost-tint {
      /* the screen's glow spilling faintly onto the text side */
      position: absolute;
      inset: 0;
      background: radial-gradient(ellipse 45% 40% at 62% 50%, rgba(199, 212, 184, 0.05), transparent 70%);
      pointer-events: none;
    }

    .cost-inner {
      width: min(1200px, 100%);
      margin: 0 auto;
      position: relative;
      z-index: 1;
    }

    .cost-lines {
      max-width: 52%;
    }

    .cost-line {
      color: var(--bone);
      font-size: clamp(1.6rem, 3vw, 2.6rem);
      line-height: 1.25;
      letter-spacing: -0.01em;
      margin-bottom: 2.2rem;
      opacity: 0;
      transform: translateY(16px);
      transition: opacity 800ms ease-out, transform 800ms ease-out;
    }

    .cost-line.on {
      opacity: 1;
      transform: none;
    }

    .cost-line.on.dim {
      opacity: 0.35;
    }

    .cost-count {
      font-family: var(--font-mono);
      font-size: clamp(0.95rem, 1.6vw, 1.1rem);
      letter-spacing: 0.04em;
      color: var(--bone);
      opacity: 0.85;
      margin-top: 3.5rem;
      max-width: 52%;
      line-height: 1.9;
    }

    .cost-count .num {
      color: var(--mint);
      font-size: 1.35em;
      font-weight: 500;
    }

    @media (prefers-reduced-motion: reduce) {
      .cost-line {
        transition: none;
        opacity: 1;
        transform: none;
      }

      .cost-line.dim {
        opacity: 0.35;
      }
    }

    @media (max-width: 768px) {
      .cost-photo {
        right: 0;
        width: 100%;
      }

      /* keep the label legible: dim the photo itself, not its caption */
      .cost-photo img {
        opacity: 0.22;
      }

      .cost-tint {
        display: none;
      }

      .cost-lines,
      .cost-count {
        max-width: 100%;
      }

      /* readability over the glow */
      .cost-line {
        text-shadow: 0 2px 24px rgba(12, 14, 11, 0.95), 0 0 8px rgba(12, 14, 11, 0.85);
      }

      .cost-line.on.dim {
        opacity: 0.55;
      }

      .cost-count {
        text-shadow: 0 2px 24px rgba(12, 14, 11, 0.95), 0 0 8px rgba(12, 14, 11, 0.85);
      }

    }

    /* ===== 3. The refusal — the knurled button ===== */
    .refusal {
      position: relative;
      overflow: hidden;
      padding: 7rem 1.5rem;
    }

    .refusal-inner {
      max-width: 1200px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: 5fr 7fr;
      gap: 4rem;
      align-items: center;
    }

    .refusal-photo {
      align-self: start;
      /* let the mesh-strap corner run toward the section's top edge */
      margin-top: -7rem;
      width: 118%;
      margin-left: -9%;
      aspect-ratio: 875 / 1216;
      max-height: 130vh;
    }

    .refusal-photo img {
      -webkit-mask-image: radial-gradient(ellipse 60% 52% at 52% 48%, #000 34%, transparent 76%);
      mask-image: radial-gradient(ellipse 60% 52% at 52% 48%, #000 34%, transparent 76%);
    }

    .refusals {
      list-style: none;
      margin-top: 2.8rem;
      font-family: var(--font-serif);
      font-style: italic;
      font-size: 1.05rem;
      line-height: 2;
      max-width: 38ch;
      color: var(--bone);
    }

    .refusals li {
      padding: 1.6rem 0;
      border-bottom: 1px solid rgba(237, 234, 224, 0.12);
    }

    .refusals li:first-child {
      border-top: 1px solid rgba(237, 234, 224, 0.12);
    }

    .refusals strong {
      font-weight: 500;
      font-style: normal;
    }

    .matter {
      border-left: 2px solid var(--mint);
      padding-left: 1.4rem;
      margin-top: 2.8rem;
      font-size: 1.15rem;
      line-height: 1.6;
      max-width: 44ch;
    }

    @media (max-width: 768px) {
      .refusal {
        padding-top: 0;
      }

      .refusal-inner {
        grid-template-columns: 1fr;
        gap: 2.5rem;
      }

      .refusal-photo {
        margin-top: 0;
        aspect-ratio: auto;
        height: 55vh;
        max-height: none;
      }
    }

    /* ===== 4. The conviction — no image, deliberately ===== */
    .conviction {
      padding: 10rem 1.5rem;
    }

    .conviction-inner {
      max-width: 580px;
      margin: 0 auto;
      text-align: center;
    }

    .conviction-copy {
      font-size: 1.05rem;
      line-height: 1.75;
      color: var(--bone);
      margin: 2rem auto 3.5rem;
      max-width: 46ch;
    }

    .conviction-copy p + p {
      margin-top: 1.4rem;
    }

    .creed {
      font-family: var(--font-mono);
      font-size: 0.85rem;
      letter-spacing: 0.04em;
      color: var(--bone-dim);
      padding: 1.2rem 0;
      border-top: 1px solid rgba(237, 234, 224, 0.2);
    }

    .creed:last-child {
      border-bottom: 1px solid rgba(237, 234, 224, 0.2);
    }

    /* ===== 5. The line in the sand — lead capture ===== */
    .capture {
      position: relative;
      overflow: hidden;
      padding: 8rem 1.5rem;
    }

    .capture-inner {
      max-width: 1200px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: 6fr 5fr;
      gap: 4rem;
      align-items: center;
    }

    .capture-copy {
      max-width: 520px;
    }

    /* the product turning its face away, screen sliver at form height */
    .capture-photo {
      aspect-ratio: 875 / 1216;
      max-height: 110vh;
    }

    .capture-photo img {
      -webkit-mask-image: radial-gradient(ellipse 55% 58% at 42% 50%, #000 34%, transparent 76%);
      mask-image: radial-gradient(ellipse 55% 58% at 42% 50%, #000 34%, transparent 76%);
    }

    .capture-sub {
      font-family: var(--font-mono);
      font-size: 0.85rem;
      letter-spacing: 0.04em;
      color: var(--bone-dim);
      margin-top: 1.6rem;
      line-height: 1.8;
    }

    .coupon {
      margin-top: 2.6rem;
    }

    .coupon input[type='email'] {
      width: 100%;
      padding: 14px;
      background: transparent;
      border: 1px solid rgba(237, 234, 224, 0.4);
      font-family: var(--font-mono);
      font-size: 0.9rem;
      letter-spacing: 0.02em;
      color: var(--bone);
    }

    .coupon input[type='email']::placeholder {
      color: rgba(237, 234, 224, 0.3);
    }

    .coupon button {
      width: 100%;
      margin-top: 12px;
      padding: 14px;
      background: var(--bone);
      border: 1px solid var(--bone);
      color: var(--black);
      font-family: var(--font-mono);
      font-size: 0.85rem;
      font-weight: 500;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      cursor: pointer;
    }

    .coupon button:disabled {
      opacity: 0.6;
      cursor: wait;
    }

    .honeypot {
      position: absolute;
      left: -9999px;
      width: 1px;
      height: 1px;
      overflow: hidden;
    }

    .form-error {
      display: none;
      font-family: var(--font-mono);
      font-size: 0.8rem;
      letter-spacing: 0.02em;
      color: #C08A7E;
      margin-top: 10px;
    }

    .form-error.show {
      display: block;
    }

    .form-success {
      display: none;
      border: 1px solid rgba(237, 234, 224, 0.4);
      padding: 1.6rem 1.4rem;
      margin-top: 2.6rem;
      font-size: 1.05rem;
      line-height: 1.6;
    }

    .form-success.show {
      display: block;
    }

    .fine-print {
      font-family: var(--font-mono);
      font-size: 0.75rem;
      letter-spacing: 0.04em;
      color: var(--bone-dim);
      margin-top: 1.6rem;
    }

    @media (max-width: 768px) {
      .capture-inner {
        grid-template-columns: 1fr;
        gap: 2.5rem;
      }

      .capture-photo {
        order: -1;
        aspect-ratio: auto;
        height: 50vh;
        max-height: none;
      }
    }

    /* ===== Footer ===== */
    footer {
      padding: 3rem 1.5rem;
      text-align: center;
      font-family: var(--font-mono);
      font-size: 0.7rem;
      letter-spacing: 0.12em;
      opacity: 0.4;
    }
  </style>

  <div class="grain" aria-hidden="true"></div>

  <main>
    <!-- 1. Hero — the accusation. The darkness is the hero. -->
    <section class="hero">
      <header class="reveal">
        <p class="wordmark">VOLT</p>
        <div class="rainbow" aria-hidden="true"></div>
      </header>

      <h1 class="reveal" style="--d: 150ms">
        They put a slot machine on your wrist. You called it an upgrade.
      </h1>

      <p class="hero-caption reveal" style="--d: 300ms">
        Every buzz is a bet placed on your attention. The house always wins.
      </p>

      <div class="scroll-cue" aria-hidden="true">▼</div>
    </section>

    <!-- 2. The cost — the waking LCD as temptation -->
    <section class="cost">
      <div class="cost-photo fragment reveal">
        <img src="/images/teaser-screen.jpg" alt="" aria-hidden="true" loading="lazy" />
      </div>
      <div class="cost-tint" aria-hidden="true"></div>

      <div class="cost-inner">
        <div class="cost-lines" id="costLines">
          <p class="cost-line">The report you never finished.</p>
          <p class="cost-line">The dinner you only half attended.</p>
          <p class="cost-line">The run cut short at mile two.</p>
          <p class="cost-line">The sleep you traded for a glow at 11:47 PM.</p>
        </div>

        <p class="cost-count" id="costCount">
          You checked your wrist <span class="num" id="counter">0</span> times today. How many were worth it?
        </p>
      </div>
    </section>

    <!-- 3. The refusal — one physical control beside a list of refusals -->
    <section class="refusal">
      <div class="refusal-inner">
        <div class="refusal-photo fragment reveal">
          <img src="/images/teaser-button.jpg" alt="" aria-hidden="true" loading="lazy" />
        </div>

        <div>
          <h2 class="reveal">Something is coming that refuses to behave.</h2>

          <p class="aside reveal" style="--d: 100ms; margin-top: 1.4rem">
            One honest button. Machined, not rendered.
          </p>

          <ul class="refusals">
            <li class="reveal" style="--d: 150ms"><strong>Never</strong> interrupt your work block for a flash sale.</li>
            <li class="reveal" style="--d: 250ms"><strong>Never</strong> buzz through dinner for an email that could wait.</li>
            <li class="reveal" style="--d: 350ms"><strong>Never</strong> turn your run into a public scoreboard.</li>
            <li class="reveal" style="--d: 450ms"><strong>Never</strong> glow in your bedroom after 9 PM.</li>
          </ul>

          <p class="matter reveal" style="--d: 550ms">
            The people who truly matter always get through. The rest arrives in batches, on your schedule.
          </p>
        </div>
      </div>
    </section>

    <!-- 4. The conviction — the rest beat. No image, deliberately. -->
    <section class="conviction">
      <div class="conviction-inner">
        <h2 class="reveal">We left nothing for you to configure.</h2>

        <div class="conviction-copy reveal" style="--d: 100ms">
          <p>
            We made the decisions. That's what building something means. One product, one opinion.
            Made to last years on your wrist — not until next year's launch.
          </p>
          <p>
            Every smartwatch is the same soulless slab of glass. Volt is an object — corners you can
            feel, a texture that catches light, a face of its own. Designed the way things used to be
            designed: like they mattered.
          </p>
        </div>

        <div class="reveal" style="--d: 200ms">
          <p class="creed">Ready the day it arrives.</p>
          <p class="creed">Drawn by hand before it was ever a file.</p>
          <p class="creed">No annual upgrade to chase.</p>
        </div>
      </div>
    </section>

    <!-- 5. The line in the sand — the product turns its face away -->
    <section class="capture">
      <div class="capture-inner">
        <div class="capture-copy">
          <h2 class="reveal">The first units go to the people who get it.</h2>

          <p class="capture-sub reveal" style="--d: 150ms">
            You haven't seen it. That's the point. Leave your email — you'll see it first.
          </p>

          <form class="coupon reveal" style="--d: 300ms" id="leadForm" method="POST" action="/api/subscribe" novalidate>
            <label class="honeypot" aria-hidden="true">
              Leave this field empty
              <input type="text" name="website" tabindex="-1" autocomplete="off" />
            </label>

            <input
              type="email"
              id="email"
              name="email"
              placeholder="you@example.com"
              autocomplete="email"
              required
              aria-describedby="emailError"
            />
            <p class="form-error" id="emailError" role="alert"></p>

            <button type="submit" id="submitBtn">Cut the leash</button>
          </form>

          <div class="form-success" id="formSuccess" role="status">
            You're on the list. Unit by unit, we'll notify in order of arrival. You'll see it before anyone.
          </div>

          <p class="fine-print reveal" style="--d: 400ms">
            One email when Volt opens. No others. We promise little on purpose.
          </p>

          <p class="aside reveal" style="--d: 500ms; margin-top: 2.6rem">
            It doesn't need to face you to be beautiful.
          </p>
        </div>

        <div class="capture-photo fragment reveal">
          <img src="/images/teaser-profile.jpg" alt="" aria-hidden="true" loading="lazy" />
        </div>
      </div>
    </section>
  </main>

  <footer>VOLT · built to last</footer>

  <script>
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // ---- Reveals + fragment breathe: once, via IntersectionObserver ----
    const revealEls = document.querySelectorAll('.reveal');
    if (reducedMotion || !('IntersectionObserver' in window)) {
      revealEls.forEach((el) => el.classList.add('is-visible'));
    } else {
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              io.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.15, rootMargin: '0px 0px -40px 0px' }
      );
      revealEls.forEach((el) => io.observe(el));
    }

    // ---- Cost lines: one at a time, previous dims to 35% ----
    const lines = Array.from(document.querySelectorAll('.cost-line'));
    const showLines = () => {
      if (reducedMotion) {
        lines.forEach((line, i) => {
          line.classList.add('on');
          if (i < lines.length - 1) line.classList.add('dim');
        });
        return;
      }
      lines.forEach((line, i) => {
        setTimeout(() => {
          line.classList.add('on');
          if (i > 0) lines[i - 1].classList.add('dim');
        }, i * 900);
      });
    };

    const linesIo = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          linesIo.disconnect();
          showLines();
        }
      },
      { threshold: 0.3 }
    );
    linesIo.observe(document.getElementById('costLines'));

    // ---- Counter: 0 → 94 over 1.2s, once ----
    const counterEl = document.getElementById('counter');
    const runCounter = () => {
      if (reducedMotion) {
        counterEl.textContent = '94';
        return;
      }
      const start = performance.now();
      const tick = (now) => {
        const progress = Math.min((now - start) / 1200, 1);
        counterEl.textContent = String(Math.round(94 * progress));
        if (progress < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    };

    const countIo = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          countIo.disconnect();
          runCounter();
        }
      },
      { threshold: 0.5 }
    );
    countIo.observe(document.getElementById('costCount'));

    // ---- Coupon form ----
    const form = document.getElementById('leadForm');
    const emailInput = document.getElementById('email');
    const emailError = document.getElementById('emailError');
    const submitBtn = document.getElementById('submitBtn');
    const formSuccess = document.getElementById('formSuccess');

    const showSuccess = () => {
      form.style.display = 'none';
      formSuccess.classList.add('show');
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      emailError.textContent = '';
      emailError.classList.remove('show');

      const email = emailInput.value.trim();
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        emailError.textContent = "That email doesn't look right.";
        emailError.classList.add('show');
        return;
      }

      // Bots that fill the honeypot get a quiet success and no request.
      if (form.elements.website.value) {
        showSuccess();
        return;
      }

      submitBtn.disabled = true;

      try {
        const params = new URLSearchParams(window.location.search);
        const response = await fetch('/api/subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            email,
            utm_source: params.get('utm_source') || '',
            utm_medium: params.get('utm_medium') || '',
            utm_campaign: params.get('utm_campaign') || '',
          }),
        });

        // 409 = already on the list; treated as success.
        if (response.ok || response.status === 409) {
          showSuccess();
        } else {
          emailError.textContent = 'Something went wrong. Try again.';
          emailError.classList.add('show');
          submitBtn.disabled = false;
        }
      } catch {
        emailError.textContent = 'Something went wrong. Try again.';
        emailError.classList.add('show');
        submitBtn.disabled = false;
      }
    });

    // ---- Font verification (acceptance: no serif fallback) ----
    document.fonts.ready.then(() => {
      const garamond = document.fonts.check('1rem "EB Garamond"');
      const plex = document.fonts.check('1rem "IBM Plex Mono"');
      console.log(`[volt] EB Garamond loaded: ${garamond} · IBM Plex Mono loaded: ${plex}`);
      if (!garamond || !plex) console.warn('[volt] FONT FALLBACK IN EFFECT — check /fonts/*.woff2');
    });
  </script>
</Layout>
