          <div class="session" id="session" hidden>
            <div class="s-receipt" id="sessionReceipt">
              <div class="paper-tex" aria-hidden="true"></div>
            </div>
            <button type="button" class="keep-btn fw" id="keepBtn">keep it</button>
          </div>

          <p class="fine-print step">
            One email when Volt opens. No others. We promise little on purpose.
          </p>
        </div>

        <div>
          <div class="list-photo">
            <img src="/images/teaser-profile.jpg" alt="" aria-hidden="true" loading="lazy" />
          </div>
          <p class="caption list-caption">it doesn't need to face you to be beautiful.</p>
        </div>
      </div>
    </section>

    <!-- 10 — The Batch: the held interruptions, delivered where they belong -->
    <section class="batch" id="batch">
      <span class="marker">10 — THE BATCH</span>
      <p class="batch-line fw" id="batchLine"></p>
      <div class="batch-stack" id="batchStack" aria-hidden="true"></div>
    </section>
  </main>

  <!-- The Pulse -->
  <footer id="pulse">
    <span class="pulse-dot" aria-hidden="true"></span>
    <p class="footer-mark">VOLT · built to last</p>
    <div class="claims">
      <p>no cookie banner. we don't track you.</p>
      <p>this page weighs less than your attention.</p>
    </div>
  </footer>

  <script>
    const rm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const night = document.documentElement.classList.contains('night');
    const io = 'IntersectionObserver' in window;
    const finePointer = window.matchMedia('(pointer: fine)').matches;

    // Observe once, then run
    const once = (el, fn, threshold = 0.4) => {
      if (!el) return;
      if (rm || !io) {
        fn();
        return;
      }
      const o = new IntersectionObserver(
        (entries) => {
          if (entries.some((e) => e.isIntersecting)) {
            o.disconnect();
            fn();
          }
        },
        { threshold }
      );
      o.observe(el);
    };

    // verb: print — fast character feed
    const printText = (el, text, cps, done) => {
      if (rm) {
        el.textContent = text;
        if (done) done();
        return;
      }
      let i = 0;
      const step = () => {
        i += 2;
        el.textContent = text.slice(0, i);
        if (i < text.length) {
          setTimeout(step, cps);
        } else if (done) {
          done();
        }
      };
      step();
    };

    // shared rAF-throttled scroll bus
    const scrollFns = [];
    let scrollScheduled = false;
    const onScroll = (fn) => {
      scrollFns.push(fn);
      fn();
    };
    window.addEventListener(
      'scroll',
      () => {
        if (!scrollScheduled) {
          scrollScheduled = true;
          requestAnimationFrame(() => {
            scrollScheduled = false;
            scrollFns.forEach((f) => f());
          });
        }
      },
      { passive: true }
    );

    /* ===== §3 personality budget: one voice at a time, ≥30s apart, once per visit ===== */
    const P = { activeUntil: 0, lastAt: 0, fired: {} };
    ['tabtrap', 'doomscroll', 'hold', 'session'].forEach((k) => {
      try {
        if (sessionStorage.getItem('volt-p-' + k)) P.fired[k] = true;
      } catch (e) {}
    });
    const canStamp = (name, repeat) => {
      const now = Date.now();
      if (now < P.activeUntil) return false;
      if (!repeat && P.fired[name]) return false;
      if (P.lastAt && now - P.lastAt < 30000) return false;
      return true;
    };
    const claimStamp = (name, durMs, repeat) => {
      if (!canStamp(name, repeat)) return false;
      P.activeUntil = Date.now() + durMs;
      P.lastAt = Date.now();
      if (!repeat) {
        P.fired[name] = true;
        try {
          sessionStorage.setItem('volt-p-' + name, '1');
        } catch (e) {}
      }
      return true;
    };

    /* ===== session metrics (client-side, session-only, never sent) ===== */
    const sessionStart = Date.now();
    let scrollBursts = 0;
    let tabEscapes = 0;
    let lastBurst = 0;
    window.addEventListener(
      'scroll',
      () => {
        const now = Date.now();
        if (now - lastBurst > 400) {
          scrollBursts++;
          lastBurst = now;
        }
      },
      { passive: true }
    );

    /* ===== 00 — Boot stamp (≤0.8s, cuts) ===== */
    const boot = document.getElementById('boot');
    const bootLine = document.getElementById('bootLine');
    const BOOT_TEXT = 'unit #001 — drawn by hand before it was ever a file';

    const startHero = () => {
      const lines = document.querySelectorAll('.hl-line');
      if (rm) {
        lines.forEach((l) => l.classList.add('on'));
        document.getElementById('heroSub').classList.add('on');
        document.getElementById('reel').classList.add('lit');
        return;
      }
      lines.forEach((l, i) => setTimeout(() => l.classList.add('on'), i * 220));
      setTimeout(() => document.getElementById('heroSub').classList.add('on'), 660);
      // the reel ignites last: brightness 0 → 1 in 120ms
      setTimeout(() => document.getElementById('reel').classList.add('lit'), 820);
    };

    const runBoot = () => {
      const firstVisit = document.documentElement.hasAttribute('data-boot');
      if (!firstVisit || rm) {
        if (boot) boot.remove();
        try {
          localStorage.setItem('volt-boot', '1');
        } catch (e) {}
        startHero();
        return;
      }
      const start = performance.now();
      const typeMs = 500;
      const tick = (now) => {
        const p = Math.min((now - start) / typeMs, 1);
        bootLine.textContent = BOOT_TEXT.slice(0, Math.round(BOOT_TEXT.length * p));
        if (p < 1) {
          requestAnimationFrame(tick);
        } else {
          setTimeout(() => {
            boot.remove();
            document.documentElement.removeAttribute('data-boot');
            try {
              localStorage.setItem('volt-boot', '1');
            } catch (e) {}
            startHero();
          }, 250);
        }
      };
      requestAnimationFrame(tick);
    };
    runBoot();

    /* ===== reel: paused while off-screen ===== */
    const reel = document.getElementById('reel');
    if (io && !rm) {
      new IntersectionObserver((entries) => {
        entries.forEach((e) => reel.classList.toggle('paused', !e.isIntersecting));
      }).observe(reel);
    } else {
      reel.classList.remove('paused');
    }

    /* ===== night stamp: live local time ===== */
    if (night) {
      const stamp = document.getElementById('nightStamp');
      const fmt = () => {
        const d = new Date();
        let h = d.getHours();
        const ap = h >= 12 ? 'pm' : 'am';
        h = h % 12 || 12;
        const m = String(d.getMinutes()).padStart(2, '0');
        stamp.textContent = `it's ${h}:${m} ${ap}. this page won't glow in your bedroom.`;
      };
      fmt();
      setInterval(fmt, 30000);
    }

    /* ===== generic step reveals (single opacity step — not a fade) ===== */
    const steps = document.querySelectorAll('.step');
    if (!io) {
      steps.forEach((el) => el.classList.add('on'));
    } else {
      const so = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('on');
              so.unobserve(e.target);
            }
          });
        },
        { threshold: 0.2, rootMargin: '0px 0px -40px 0px' }
      );
      steps.forEach((el) => {
        if (el.id === 'heroSub' || el.id === 'ornot' || el.id === 'noiseFw' || el.id === 'tallyQ') return;
        so.observe(el);
      });
    }

    /* ===== 02 — The Tally: scroll-scrubbed odometer ===== */
    const tally = document.getElementById('tally');
    const drums = document.getElementById('drums');
    const drumCols = [document.getElementById('drumTens'), document.getElementById('drumOnes')];
    const tallyClock = document.getElementById('tallyClock');
    const ticksEl = document.getElementById('ticks');
    const tallyFw = document.getElementById('tallyFw');
    const tallyQ = document.getElementById('tallyQ');

    // build drum columns: digits 0..9 plus wrap digits so 9→0 rolls forward
    drumCols.forEach((col) => {
      col.innerHTML = Array.from({ length: 12 }, (_, i) => `<div>${i % 10}</div>`).join('');
    });

    // build 96 ticks; three of them mattered (09:12, 14:30, 21:00 → indices 13, 45, 84)
    const MATTER = { 13: '09:12 — her call', 45: '14:30 — the reminder', 84: '21:00 — day, closed' };
    const tickEls = [];
    for (let i = 0; i < 96; i++) {
      const t = document.createElement('span');
      t.className = 'tick' + (MATTER[i] ? ' matters' : '');
      ticksEl.appendChild(t);
      tickEls.push(t);
      if (MATTER[i]) {
        const lab = document.createElement('span');
        lab.className = 'tick-label' + (i === 45 ? ' tl-mid' : '');
        lab.style.left = (i / 95) * 100 + '%';
        lab.textContent = MATTER[i];
        ticksEl.appendChild(lab);
      }
    }

    let tallyLit = 0;
    let tallyLocked = false;
    let verdictDone = false;

    const setDrums = (exact) => {
      // odometer mechanics: tens only rolls while ones passes 9 → 0
      const ones = exact % 10;
      const tens = Math.floor(exact / 10) + Math.max(0, (exact % 10) - 9);
      drumCols[0].style.transform = `translateY(${(1 - tens).toFixed(3)}em)`;
      drumCols[1].style.transform = `translateY(${(1 - ones).toFixed(3)}em)`;
    };

    const setClock = (exact) => {
      const t = 7 + (exact / 96) * 16;
      const hh = Math.min(23, Math.floor(t));
      const mm = Math.floor((t - hh) * 60);
      tallyClock.textContent = `${String(hh).padStart(2, '0')}:${String(mm).padStart(2, '0')}`;
    };

    const setTicks = (count) => {
      if (count > tallyLit) {
        for (let i = tallyLit; i < count; i++) {
          const t = tickEls[i];
          t.classList.add('lit', 'flick');
          setTimeout(() => t.classList.remove('flick'), 90);
        }
      } else if (count < tallyLit) {
        for (let i = count; i < tallyLit; i++) tickEls[i].classList.remove('lit', 'flick');
      }
      tallyLit = count;
    };

    const lockTally = () => {
      ticksEl.classList.add('out');
      if (!tallyLocked && !rm) {
        drums.classList.add('clunk');
        setTimeout(() => drums.classList.remove('clunk'), 120);
      }
      tallyLocked = true;
      if (!verdictDone) {
        verdictDone = true;
        printText(tallyFw, '96 glances. 3 mattered. volt shows you those.', 16, () => {
          setTimeout(() => tallyQ.classList.add('on'), 500);
        });
      }
    };

    const renderTally = (exact) => {
      setDrums(exact);
      setClock(exact);
      setTicks(Math.floor(exact));
      if (exact >= 95.99) {
        lockTally();
      } else if (tallyLocked && exact < 95.5) {
        // rewinding the day is legitimate — the strip re-lights; the verdict stays printed
        ticksEl.classList.remove('out');
        tallyLocked = false;
      }
    };

    if (rm) {
      renderTally(96); // static end-state composition
    } else {
      onScroll(() => {
        const rect = tally.getBoundingClientRect();
        const total = rect.height - window.innerHeight;
        const p = Math.min(Math.max(-rect.top / total, 0), 1);
        renderTally(p * 96);
      });
    }

    /* ===== 03 — The Cost: scroll beats (verb: replace) ===== */
    const cost = document.getElementById('cost');
    const costLines = Array.from(document.querySelectorAll('.cost-line'));

    if (rm) {
      costLines.forEach((l, i) => {
        l.classList.add('on');
        if (i < costLines.length - 1) l.classList.add('dim');
      });
    } else {
      onScroll(() => {
        const rect = cost.getBoundingClientRect();
        const total = rect.height - window.innerHeight;
        const p = Math.min(Math.max(-rect.top / total, 0), 1);
        const idx = Math.min(3, Math.floor(p / 0.2));
        costLines.forEach((l, i) => {
          l.classList.toggle('on', p > 0.02 && i <= idx);
          l.classList.toggle('dim', i < idx);
        });
      });
    }

    /* ===== 04 — The Noise ===== */
    const noise = document.getElementById('noise');
    const noiseCards = document.getElementById('noiseCards');
    const ornot = document.getElementById('ornot');
    const noiseFw = document.getElementById('noiseFw');
    const flashover = document.getElementById('flashover');
    const blackout = document.getElementById('blackout');
    const grain = document.getElementById('grain');

    // real card anatomy: icon / title / body — the notifications everyone knows
    const CARDS = [
      ['✦', 'Flash Sale', 'Ends tonight — 20% off everything'],
      ['♥', 'Social', 'Someone liked your photo'],
      ['◔', 'Screen Time', 'Your weekly report is ready'],
      ['●', 'Followers', 'You have 3 new followers'],
      ['▣', 'Delivery', 'Your package is 2 stops away'],
      ['⚑', 'Streak', "Don't lose your 41-day streak!"],
      ['⚿', 'Security', 'New login from Chrome on Windows'],
      ['◍', 'Trending', 'Trending near you: 7 stories'],
      ['❑', 'Memories', 'Your memories from 2019'],
      ['◒', 'Battery', 'Battery at 20% — turn on saver?'],
      ['@', 'Mentions', 'Someone mentioned you'],
      ['✦', 'Offer', 'Limited offer: 2 hours left'],
    ];

    const makeCard = ([icon, title, body]) => {
      const el = document.createElement('div');
      el.className = 'noise-card';
      el.innerHTML = `<span class="nc-icon">${icon}</span><div><div class="nc-title">${title}</div><div class="nc-body">${body}</div></div>`;
      return el;
    };

    const scatterCard = (el, i, tidy) => {
      if (tidy) {
        // night: slightly scattered but never text-on-text
        el.style.left = 6 + (i % 3) * 31 + '%';
        el.style.top = 8 + Math.floor(i / 3) * 22 + '%';
        el.style.transform = `rotate(${(i % 2 ? -1.5 : 1.5).toFixed(1)}deg)`;
      } else {
        el.style.left = 4 + Math.random() * 62 + '%';
        el.style.top = 6 + Math.random() * 68 + '%';
        el.style.transform = `rotate(${(Math.random() * 14 - 7).toFixed(1)}deg)`;
      }
      el.style.zIndex = String(i);
    };

    const staticCollage = (tidy) => {
      CARDS.slice(0, tidy ? 9 : 12).forEach((c, i) => {
        const el = makeCard(c);
        scatterCard(el, i, tidy);
        noiseCards.appendChild(el);
      });
      noise.classList.add('calm');
    };

    if (night) {
      staticCollage(true); // not tonight.
    } else if (rm) {
      staticCollage(false);
      ornot.classList.add('on');
      noiseFw.classList.add('on');
    } else {
      let fired = false;
      once(
        noise,
        () => {
          if (fired) return;
          fired = true;

          let delay = 0;
          const gaps = [0, 260, 200, 160, 130, 105, 85, 70, 58, 48, 40, 34];
          CARDS.forEach((c, i) => {
            delay += gaps[i];
            setTimeout(() => {
              const el = makeCard(c);
              scatterCard(el, i, false);
              noiseCards.appendChild(el);
            }, delay);
          });

          grain.classList.add('hot');
          const bStart = performance.now();
          const brighten = (now) => {
            const p = Math.min((now - bStart) / 1200, 1);
            flashover.style.opacity = String(p * 0.92);
            if (p < 1) requestAnimationFrame(brighten);
          };
          requestAnimationFrame(brighten);

          // HARD CUT to black. no transition. 700ms of absolute nothing.
          setTimeout(() => {
            blackout.style.display = 'block';
            flashover.style.opacity = '0';
            grain.classList.remove('hot');
            noiseCards.innerHTML = '';

            setTimeout(() => {
              blackout.style.display = 'none';
              ornot.classList.add('on');
              setTimeout(() => noiseFw.classList.add('on'), 600);
            }, 700);
          }, 1250);
        },
        0.55
      );
    }

    /* ===== 05 — the ledger stamps in ===== */
    const ledgerRows = document.querySelectorAll('#ledger li');
    once(
      document.getElementById('ledger'),
      () => {
        ledgerRows.forEach((li, i) => setTimeout(() => li.classList.add('on'), i * 220));
      },
      0.3
    );

    /* ===== §3.2 cursor pool of light — 05 and 07 only ===== */
    const pools = document.querySelectorAll('.pool');
    pools.forEach((pool) => {
      const veil = pool.querySelector('.pool-veil');
      if (!veil) return;
      if (finePointer) {
        pool.addEventListener('pointermove', (e) => {
          const r = pool.getBoundingClientRect();
          veil.style.setProperty('--mx', ((e.clientX - r.left) / r.width) * 100 + '%');
          veil.style.setProperty('--my', ((e.clientY - r.top) / r.height) * 100 + '%');
        });
      } else if (!rm) {
        // touch: slow autonomous drift
        let visible = true;
        if (io) {
          new IntersectionObserver((es) => {
            visible = es.some((e) => e.isIntersecting);
          }).observe(pool);
        }
        const drift = (t) => {
          if (visible) {
            veil.style.setProperty('--mx', 50 + 34 * Math.sin(t * 0.00011) + '%');
            veil.style.setProperty('--my', 50 + 28 * Math.cos(t * 0.00007) + '%');
          }
          requestAnimationFrame(drift);
        };
        requestAnimationFrame(drift);
      }
    });

    /* ===== 07 — the hold ritual (dormant until the bench asset ships) ===== */
    const chalk = document.getElementById('chalk');
    if (chalk) {
      const chalkLabel = document.getElementById('chalkLabel');
      const glimpse = document.getElementById('glimpse');
      let holdStep = 0;
      let holdTimer = null;
      let slipTimer = null;

      const setHold = (v) => {
        holdStep = Math.max(0, Math.min(12, v));
        chalk.style.setProperty('--hold', String(holdStep));
      };

      const payoff = () => {
        if (!claimStamp('hold', 5000)) {
          setHold(0);
          return;
        }
        glimpse.classList.add('show');
        setTimeout(() => {
          glimpse.classList.remove('show');
          setHold(0);
          chalkLabel.textContent = "you've seen enough.";
          printText(chalkLabel, "unit #001 exists. that's all you get.", 18, () => {
            setTimeout(() => (chalkLabel.textContent = "you've seen enough."), 2600);
          });
        }, 400);
      };

      const engrave = () => {
        if (P.fired.hold) return;
        clearInterval(slipTimer);
        holdTimer = setInterval(() => {
          setHold(holdStep + 1); // ratchet: 12 discrete steps, not smooth
          if (holdStep >= 12) {
            clearInterval(holdTimer);
            payoff();
          }
        }, 250);
      };

      const slip = () => {
        clearInterval(holdTimer);
        if (holdStep > 0 && holdStep < 12) {
          slipTimer = setInterval(() => {
            setHold(holdStep - 1);
            if (holdStep <= 0) clearInterval(slipTimer);
          }, 40);
        }
      };

      chalk.addEventListener('pointerdown', (e) => {
        e.preventDefault();
        engrave();
      });
      chalk.addEventListener('pointerup', slip);
      chalk.addEventListener('pointerleave', slip);

      if (P.fired.hold) chalkLabel.textContent = "you've seen enough.";
    }

    /* ===== 08 — the receipt prints on scrub (not a timer) ===== */
    const receipt = document.getElementById('receipt');
    const receiptLines = Array.from(document.querySelectorAll('#receipt .rl'));
    let printedCount = 0;

    const printReceipt = (count) => {
      // a receipt can't unprint — monotonic
      for (let i = printedCount; i < count; i++) {
        const l = receiptLines[i];
        l.classList.add('on');
        l.style.transform = `translateY(${(Math.random() * 2 - 1).toFixed(2)}px)`; // feed jitter
      }
      printedCount = Math.max(printedCount, count);
    };

    if (rm) {
      printReceipt(receiptLines.length);
    } else {
      onScroll(() => {
        const rect = receipt.getBoundingClientRect();
        const vh = window.innerHeight;
        const p = Math.min(Math.max((vh - rect.top) / (vh * 0.75), 0), 1);
        printReceipt(Math.ceil(p * receiptLines.length));
      });
    }

    /* ===== 09 — the ritual ===== */
    const form = document.getElementById('leadForm');
    const tape = document.getElementById('tape');
    const emailInput = document.getElementById('email');
    const emailError = document.getElementById('emailError');
    const submitBtn = document.getElementById('submitBtn');
    const confirmBox = document.getElementById('confirm');
    const confirmUnit = document.getElementById('confirmUnit');

    const showConfirm = (unit) => {
      // real queue number or none — never fake it
      const line = unit
        ? `unit #${unit} in line. you'll see it before anyone.`
        : "you're in line. you'll see it before anyone.";

      const finish = () => {
        form.style.display = 'none';
        confirmBox.classList.add('show');
        printText(confirmUnit, line, 16, () => {
          setTimeout(() => printSessionReceipt(), 900);
        });
      };

      if (rm) {
        finish();
        return;
      }
      submitBtn.style.display = 'none';
      tape.classList.add('torn'); // verb: tear
      setTimeout(finish, 500);
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      emailError.textContent = '';
      emailError.classList.remove('show');

      const email = emailInput.value.trim();
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        emailError.textContent = "that email doesn't look right.";
        emailError.classList.add('show');
        return;
      }

      // Bots that fill the honeypot get a quiet success and no request.
      if (form.elements.website.value) {
        showConfirm(null);
        return;
      }

      submitBtn.disabled = true;

      try {
        const params = new URLSearchParams(window.location.search);
        const response = await fetch('/api/subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            email,
            utm_source: params.get('utm_source') || '',
            utm_medium: params.get('utm_medium') || '',
            utm_campaign: params.get('utm_campaign') || '',
          }),
        });

        // 409 = already on the list; treated as success.
        if (response.ok || response.status === 409) {
          let unit = null;
          try {
            const data = await response.json();
            if (data && data.unit) unit = data.unit;
          } catch (err) {}
          showConfirm(unit);
        } else {
          emailError.textContent = 'something went wrong. try again.';
          emailError.classList.add('show');
          submitBtn.disabled = false;
        }
      } catch {
        emailError.textContent = 'something went wrong. try again.';
        emailError.classList.add('show');
        submitBtn.disabled = false;
      }
    });

    /* ===== your session receipt (once per visit: CTA or exit-intent) ===== */
    const sessionBox = document.getElementById('session');
    const sessionReceipt = document.getElementById('sessionReceipt');
    const keepBtn = document.getElementById('keepBtn');
    let sessionLines = [];

    const buildSessionLines = () => {
      const secs = Math.floor((Date.now() - sessionStart) / 1000);
      const dur = `${Math.floor(secs / 60)}m${String(secs % 60).padStart(2, '0')}s`;
      const W = 26;
      const row = (label, val) => label + String(val).padStart(W - label.length);
      return [
        'VOLT · YOUR VISIT',
        '─────────────────────────',
        row('time here', dur),
        row('scrolls', scrollBursts),
        row('tab escapes', tabEscapes),
        row('interruptions from us', 0),
        '─────────────────────────',
        "felt good, didn't it?",
      ];
    };

    const printSessionReceipt = () => {
      if (P.fired.session) return;
      P.fired.session = true;
      try {
        sessionStorage.setItem('volt-p-session', '1');
      } catch (e) {}
      sessionLines = buildSessionLines();
      sessionBox.hidden = false;
      sessionLines.forEach((text, i) => {
        const span = document.createElement('span');
        span.className = 'rl';
        span.textContent = text;
        sessionReceipt.appendChild(span);
        if (rm) {
          span.classList.add('on');
        } else {
          setTimeout(() => {
            span.classList.add('on');
            span.style.transform = `translateY(${(Math.random() * 2 - 1).toFixed(2)}px)`;
          }, i * 80);
        }
      });
    };

    // exit-intent (desktop): if the visitor never reached the CTA
    document.addEventListener('mouseout', (e) => {
      if (!e.relatedTarget && e.clientY <= 0) printSessionReceipt();
    });

    // keep it → client-side PNG render
    keepBtn.addEventListener('click', () => {
      const lines = sessionLines.length ? sessionLines : buildSessionLines();
      const c = document.createElement('canvas');
      const scale = 2;
      c.width = 340 * scale;
      c.height = (60 + lines.length * 26) * scale;
      const x = c.getContext('2d');
      x.scale(scale, scale);
      x.fillStyle = '#0A0B08';
      x.fillRect(0, 0, 340, 60 + lines.length * 26);
      x.fillStyle = '#E8E4DA';
      x.font = '13px "IBM Plex Mono", monospace';
      lines.forEach((t, i) => x.fillText(t, 24, 42 + i * 26));
      const a = document.createElement('a');
      a.download = 'volt-visit.png';
      a.href = c.toDataURL('image/png');
      a.click();
    });

    /* ===== §3.6 held interruptions + 10 — The Batch ===== */
    const heldEl = document.getElementById('held');
    const batch = document.getElementById('batch');
    const batchLine = document.getElementById('batchLine');
    const batchStack = document.getElementById('batchStack');

    const NAGS = [
      ['○', '20% off', 'today only'],
      ['○', 'newsletter', "don't miss our newsletter"],
      ['○', 'feedback', 'rate your experience'],
      ['○', 'notifications', 'turn on notifications?'],
      ['○', 'cart', 'your cart misses you'],
      ['○', 'offer', '2 hours left on your offer'],
      ['○', 'survey', 'one quick question for you'],
    ];
    const heldNags = [];
    const nagQueue = [];

    const flushNags = () => {
      if (!nagQueue.length) return;
      // a bump is the quietest personality voice — it waits its turn
      if (Date.now() < P.activeUntil) return;
      const nag = nagQueue.shift();
      heldNags.push(nag);
      heldEl.hidden = false;
      heldEl.textContent = `held: ${heldNags.length}`; // no animation beyond the number swap
    };
    setInterval(flushNags, 2500);

    const suppressNag = (i) => {
      if (heldNags.length + nagQueue.length >= 7) return;
      nagQueue.push(NAGS[i]);
      flushNags();
    };

    // organic milestones: one per section
    [
      ['cost', 0],
      ['noise', 1],
      ['refusal', 2],
      ['receipt', 4],
    ].forEach(([id, nagIdx], k) => {
      once(document.getElementById(id), () => suppressNag(nagIdx), 0.35);
    });
    once(document.querySelector('.conviction'), () => suppressNag(3), 0.35);
    once(document.querySelector('.list-sec'), () => suppressNag(5), 0.35);

    let batchDone = false;
    once(
      batch,
      () => {
        if (batchDone) return;
        batchDone = true;
        // deliver whatever is held OR queued by now
        while (nagQueue.length && heldNags.length < 7) heldNags.push(nagQueue.shift());
        heldEl.textContent = `held: ${heldNags.length}`;
        if (!heldNags.length) {
          batchLine.textContent = 'nothing worth holding.';
          return;
        }
        printText(
          batchLine,
          `while you read, we held ${heldNags.length} interruptions. here they are, together, where they belong.`,
          14,
          () => {
            heldNags.forEach(([icon, title, body]) => batchStack.appendChild(makeCard([icon, title, body])));
            requestAnimationFrame(() => batchStack.classList.add('delivered'));
            heldEl.hidden = true;
            if (!rm) setTimeout(() => batchStack.classList.add('crumble'), 1600);
          }
        );
      },
      0.35
    );

    /* ===== §3.1 tab-title trap (once per visit) ===== */
    const topStamp = document.getElementById('topStamp');
    const origTitle = document.title;
    let awayTimer = null;
    let trapped = false;
    let favLink = null;

    const setFavDot = (on) => {
      try {
        const c = document.createElement('canvas');
        c.width = c.height = 32;
        const x = c.getContext('2d');
        x.fillStyle = '#0C0E0B';
        x.fillRect(0, 0, 32, 32);
        if (on) {
          x.fillStyle = '#FFB000';
          x.beginPath();
          x.arc(23, 9, 6, 0, 7);
          x.fill();
        }
        if (!favLink) {
          favLink = document.createElement('link');
          favLink.rel = 'icon';
          document.head.appendChild(favLink);
        }
        favLink.href = c.toDataURL('image/png');
      } catch (e) {}
    };

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        tabEscapes++;
        resetIdle(true);
        if (!P.fired.tabtrap) {
          awayTimer = setTimeout(() => {
            document.title = '(1) VOLT — new notification';
            setFavDot(true);
            trapped = true;
          }, 2000);
        }
      } else {
        clearTimeout(awayTimer);
        resetIdle(false);
        if (trapped) {
          document.title = origTitle;
          setFavDot(false);
          trapped = false;
          if (claimStamp('tabtrap', 6000)) {
            topStamp.textContent = "you came back for a notification that doesn't exist. that's the reflex.";
            topStamp.classList.add('show');
            setTimeout(() => topStamp.classList.remove('show'), 6000);
          }
        }
      }
    });

    /* ===== §3.3 doomscroll refusal (once per visit) ===== */
    const ghostLine = document.getElementById('ghostLine');
    let franticSince = 0;
    let lastScrollY = window.scrollY;
    let lastScrollT = performance.now();

    window.addEventListener(
      'scroll',
      () => {
        const now = performance.now();
        const dy = Math.abs(window.scrollY - lastScrollY);
        const dt = Math.max(now - lastScrollT, 1);
        const speed = (dy / dt) * 1000;
        lastScrollY = window.scrollY;
        lastScrollT = now;

        if (speed > 2600) {
          if (!franticSince) franticSince = now;
          // never during the tally pin — scrubbing fast there is the point
          const tr = tally.getBoundingClientRect();
          const inTally = tr.top < 0 && tr.bottom > window.innerHeight;
          if (!inTally && now - franticSince > 1500 && claimStamp('doomscroll', 4000)) {
            ghostLine.classList.add('show');
            setTimeout(() => ghostLine.classList.remove('show'), 4000);
          }
        } else {
          franticSince = 0; // frantic must be sustained, not resumed
        }
      },
      { passive: true }
    );

    /* ===== §3.4 page sleep — wake on move (repeatable) ===== */
    const sleepEl = document.getElementById('sleep');
    let idleTimer = null;
    let asleep = false;

    const fallAsleep = () => {
      if (rm || document.hidden || !claimStamp('sleep', 3600000, true)) return;
      asleep = true;
      sleepEl.classList.remove('waking');
      sleepEl.classList.add('asleep');
    };

    const wake = () => {
      if (!asleep) return;
      asleep = false;
      P.activeUntil = Date.now(); // release the voice
      P.lastAt = Date.now();
      sleepEl.classList.remove('asleep');
      sleepEl.classList.add('waking');
    };

    function resetIdle(pause) {
      wake();
      clearTimeout(idleTimer);
      if (!pause && !rm) idleTimer = setTimeout(fallAsleep, 60000);
    }

    ['mousemove', 'keydown', 'scroll', 'touchstart', 'pointerdown'].forEach((ev) =>
      window.addEventListener(ev, () => resetIdle(false), { passive: true })
    );
    resetIdle(false);

    /* ===== §3.5 crown navigation ===== */
    const crown = document.getElementById('crown');
    const crownLabel = document.getElementById('crownLabel');
    const crownSections = () => Array.from(document.querySelectorAll('main > section, footer'));
    const crownNames = {
      hero: '01 — hero',
      tally: '02 — the tally',
      cost: '03 — the cost',
      noise: '04 — the noise',
      refusal: '05 — the refusal',
      conviction: '06 — the conviction',
      bench: '07 — the bench',
      'receipt-sec': '08 — the receipt',
      'list-sec': '09 — the list',
      batch: '10 — the batch',
      pulse: '— the pulse',
    };

    if (finePointer) {
      let dragY = 0;
      let dragIdx = 0;
      let rot = 0;
      let hideLabel = null;

      const labelFor = (el) => {
        for (const cls of Object.keys(crownNames)) {
          if (el.id === cls || el.classList.contains(cls)) return crownNames[cls];
        }
        return '';
      };

      crown.addEventListener('pointerdown', (e) => {
        e.preventDefault();
        crown.setPointerCapture(e.pointerId);
        crown.classList.add('grabbing');
        clearTimeout(hideLabel);
        dragY = e.clientY;
        const secs = crownSections();
        const y = window.scrollY + 10;
        dragIdx = 0;
        secs.forEach((s, i) => {
          if (s.offsetTop <= y) dragIdx = i;
        });
        crownLabel.textContent = labelFor(secs[dragIdx]);
        crownLabel.classList.add('show');
      });

      crown.addEventListener('pointermove', (e) => {
        if (!crown.classList.contains('grabbing')) return;
        const dy = e.clientY - dragY;
        rot += dy * 2;
        crown.style.transform = `translateY(-50%) rotate(${rot}deg)`;
        if (Math.abs(dy) >= 56) {
          const secs = crownSections();
          dragIdx = Math.min(Math.max(dragIdx + Math.sign(dy), 0), secs.length - 1);
          // ratchet detent: instant travel, no easing
          window.scrollTo({ top: secs[dragIdx].offsetTop, behavior: 'auto' });
          crownLabel.textContent = labelFor(secs[dragIdx]);
          dragY = e.clientY;
        }
      });

      const release = () => {
        crown.classList.remove('grabbing');
        hideLabel = setTimeout(() => crownLabel.classList.remove('show'), 600);
      };
      crown.addEventListener('pointerup', release);
      crown.addEventListener('pointercancel', release);
    }

    /* ===== font verification (acceptance: no serif fallback) ===== */
    document.fonts.ready.then(() => {
      const garamond = document.fonts.check('1rem "EB Garamond"');
      const plex = document.fonts.check('1rem "IBM Plex Mono"');
      console.log(`[volt] EB Garamond loaded: ${garamond} · IBM Plex Mono loaded: ${plex}`);
      if (!garamond || !plex) console.warn('[volt] FONT FALLBACK IN EFFECT — check /fonts/*.woff2');
    });
  </script>
</Layout>
